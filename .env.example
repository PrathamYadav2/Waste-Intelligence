# Copy to .env and fill in. NEVER commit .env. Paths are intentionally blank.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
LOG_LEVEL=INFO
AUTH_MODE=placeholder            # placeholder | api_key | jwt  (NOT_IMPLEMENTED_YET)
API_KEY=
DATABASE_URL=                    # e.g. postgresql+psycopg://user:pass@host:5432/db
DATA_ROOT=
REALWASTE_PATH=
TRASHNET_PATH=
TACO_PATH=
REGIONAL_DATA_PATH=
RECOVERY_GUIDANCE_PATH=
MODEL_REGISTRY_DIR=models
